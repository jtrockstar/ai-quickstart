# Local settings template. Copy to .env (gitignored) and fill in the values.
# This .env.example is safe to commit; never put real secrets in it.

# --- Jira Cloud (jira-toolkit scripts and the Jira MCP server) ---
# JIRA_USERNAME is your Atlassian account email; create JIRA_API_TOKEN in your
# Atlassian account's security settings (API tokens).
JIRA_URL=https://example.atlassian.net
JIRA_USERNAME=
JIRA_API_TOKEN=

# --- Source API (example-report) ---
SOURCE_API_URL=https://api.example.com
SOURCE_API_TOKEN=
